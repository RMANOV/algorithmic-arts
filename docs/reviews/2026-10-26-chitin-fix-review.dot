digraph CHITINChangedContracts {
  graph [rankdir=LR, label="CHITIN 2.0.1 manual changed-contract map; not a complete program proof", labelloc=t];
  node [shape=box];
  sense [label="_sense\nnearest UID / selected RAID UID"];
  raid [label="predictive_target\nRAID uses selected contact trail"];
  state [label="Current post-metabolism state"];
  lifetime [label="_forecast_lifetime\nbounded shared trajectory"];
  scores [label="predictive_scores\neligible action corrections"];
  choice [label="_choose\nactual action / target / decision ID"];
  movement [label="_move\ncommitted target consumer"];
  short_record [label="record_validation\nchosen 1 or 8–12 tick point"];
  before [label="before_decision\nbefore new planning cost / choice"];
  death [label="_die / observe_death\nabsorbing adverse outcome"];
  short_error [label="Short error aggregates\nvalidation_count/error_sum"];
  trust [label="Trust\nshort evidence, globally aggregated"];
  long_record [label="record / step\n30/90/180 descriptive outcomes"];
  interventions [label="Action / target / context / decision ID changes"];
  reset [label="Epoch reset\npending observations censored"];
  transition [label="Space / Map / Unmap / N / R / export"];
  revision [label="_activity_revision\nmonotonic transition identity"];
  probe [label="SoakRecorder._probe\nunchanged revision + visible + advancing + healthy"];
  active [label="Active elapsed time\nmixed intervals excluded"];
  completed [label="completed\nactive time reaches target, no error"];

  sense -> raid [label="identity-preserving observation"];
  raid -> lifetime [label="candidate target / travel"];
  state -> lifetime [label="health / energy / finite resources"];
  lifetime -> scores [label="pre-death yields / capped costs"];
  scores -> choice [label="score input, hard eligibility retained"];
  choice -> movement [label="target assignment"];
  lifetime -> short_record [label="pre-decision validation point"];
  choice -> short_record [label="selected action, actual deadline"];
  short_record -> before [label="scheduled next decision"];
  short_record -> death [label="early terminal path"];
  before -> short_error [label="settle once before intervention"];
  death -> short_error [label="adverse health evidence, no fabricated corpse energy"];
  short_error -> trust [label="only confidence error input"];
  trust -> scores [label="bounded forecast authority"];
  lifetime -> long_record [label="post-action long points"];
  choice -> long_record [label="chosen fixed-action prediction"];
  interventions -> long_record [label="explicit intervention flags"];
  interventions -> short_record [label="censor interrupted context", style=dashed];
  reset -> short_record [label="censor pending", style=dashed];
  reset -> long_record [label="censor pending", style=dashed];
  long_record -> trust [label="NO influence on trust", style=dashed, color=red, arrowhead=tee];
  transition -> revision [label="increment at real handler"];
  revision -> probe [label="interval identity guard"];
  probe -> active [label="credit eligible uninterrupted interval once"];
  active -> completed [label="duration threshold, separate from performance acceptance"];
}
